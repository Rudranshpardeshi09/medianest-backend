# Copy to .env and fill in. .env is gitignored.

DJANGO_SECRET_KEY=generate-a-real-one-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_PATH=admin

# Leave this unset. SQLite at backend/db.sqlite3 is what both development and
# production run on, so a fresh clone boots with nothing else installed.
# Setting it to a Postgres URL also needs `psycopg[binary]` in requirements.txt.
# DATABASE_URL=postgresql://user:password@localhost:5432/medianest

# The Vite dev server; add the Vercel domain in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Console backend prints the mail instead of sending it.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ENQUIRY_NOTIFY_TO=connect@medianest.co.in
