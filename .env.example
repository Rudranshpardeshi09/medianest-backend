# Copy to .env and fill in. .env is gitignored.

DJANGO_SECRET_KEY=generate-a-real-one-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_PATH=admin

# Unset -> SQLite at backend/db.sqlite3, so a fresh clone boots with nothing
# running. docker-compose.yml brings up the Postgres this is built for.
DATABASE_URL=postgresql://medianest:medianest@localhost:5432/medianest

# The Vite dev server; add the Vercel domain in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Console backend prints the mail instead of sending it.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ENQUIRY_NOTIFY_TO=connect@medianest.co.in
